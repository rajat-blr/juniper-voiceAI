{
  "name": "voiceai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "dev:agent": "bash tools/run-agent.sh",
    "dev:web": "vite apps/web --host 127.0.0.1",
    "build": "tsc --noEmit && vite build apps/web",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "demo:report": "node --import tsx tools/demo-report.ts",
    "benchmark:api": "node --import tsx tools/benchmark-api.ts",
    "verify": "node --import tsx tools/verify-project.ts",
    "db:migrate": "node --env-file-if-exists=.env.production.local --import tsx tools/migrate.ts",
    "deploy:production": "node --import tsx tools/deploy-production.ts"
  },
  "engines": { "node": "24.x" },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.1",
    "livekit-client": "^2.22.4",
    "livekit-server-sdk": "^2.19.1",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
