# Without DATABASE_URL, the API uses durable embedded PostgreSQL in .data/booking.
# DATABASE_URL=postgresql://voiceai:voiceai@127.0.0.1:5432/voiceai
BUSINESS_TIMEZONE=Asia/Kolkata
PORT=3001
SESSION_TTL_HOURS=24
WEB_ORIGIN=http://127.0.0.1:5173

# LiveKit Build (free tier). Keys stay on the API and Python worker.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
BOOKING_API_URL=http://127.0.0.1:3001
# The API generates .data/agent-secret automatically; the local worker reads it.
# AGENT_SHARED_SECRET=
# These models use the Build plan's included inference credit. No separate paid keys.
VOICE_STT_MODEL=assemblyai/universal-streaming
VOICE_LLM_MODEL=google/gemma-4-31b-it
VOICE_TTS_MODEL=fishaudio/s2.1-pro
VOICE_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a
